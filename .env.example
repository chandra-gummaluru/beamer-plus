# Copy this file to .env (same folder) to set options without the environment.
# .env is per-machine, so it's never committed (it's in .gitignore).
# The name under "Beamer+" on the start page and in the title:
# BEAMER_INSTITUTION=University of Toronto

# AI summaries in the audience-response widget (optional). Each needs its
# package too: pip install anthropic / pip install openai.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Content filter for free-text answers (open, word cloud, fill in the blanks).
# Rejected answers are never shown; the student is asked to rephrase.
# Allow and block lists are set per question, in the widget (Filter button).
# Optional stronger check: pip install detoxify
# BEAMER_CONTENT_FILTER=off
# BEAMER_TOXICITY_THRESHOLD=0.8
