# Copy this file to .env (same folder) and fill in your GitHub App's settings.
# .env holds the client secret, so it's never committed (it's in .gitignore).
# Without these, Beamer+ still works: everyone uses it as a guest.
BEAMER_GH_CLIENT_ID=
BEAMER_GH_CLIENT_SECRET=
# The app's name in its address, github.com/apps/<slug> (for the "Give Beamer+ access" link)
BEAMER_GH_APP_SLUG=
# Optional: the public address (when unset, whatever address the browser used)
# BEAMER_APP_URL=https://beamer.changapp.net/
